# Copy this file to .env and paste your Neon connection strings.
# Free Postgres: https://console.neon.tech  or  Vercel → Storage → Create Database (Neon)

# Pooled connection (use this for the app, hostname usually contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (needed for prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"
