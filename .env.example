# Copy this file to .env and paste your Neon connection strings.
# Free Postgres: https://console.neon.tech  or  Vercel → Storage → Create Database (Neon)

# Pooled connection (use this for the app, hostname usually contains -pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct connection (needed for prisma migrate)
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Shared secret for the notification endpoints. Send it as the x-notify-secret header.
NOTIFY_SECRET="replace-with-a-long-random-string"

# Gmail SMTP for started / stuck / ended alerts. Use a Google App Password.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="digitalchaos2003@gmail.com"
SMTP_PASS="your-gmail-app-password"
EMAIL_FROM="Hehehe <digitalchaos2003@gmail.com>"
